{
  "name": "@zerpto/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Theme, shared React components and the host/extension contract of Zerpto web frontends",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./extension": "./src/extension.ts",
    "./federation": {
      "types": "./src/federation.d.ts",
      "default": "./src/federation.js"
    },
    "./host.css": "./src/styles/host.css",
    "./remote.css": "./src/styles/remote.css",
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@11.0.3",
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "peerDependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  }
}
